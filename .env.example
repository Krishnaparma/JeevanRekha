# ---------------------------------------------------------------------------
# JeevanRekha · Suryanagar emergency bed network
# Is file ko copy karke ".env" naam se save karo, phir apna password daal do.
#   Windows PowerShell :  copy .env.example .env
#   macOS / Linux      :  cp .env.example .env
# ---------------------------------------------------------------------------

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Agar tumne Docker se Postgres chalaya hai (README ka Option B), to yahi line theek hai.
# Agar local Postgres install kiya hai, to "postgres" ki jagah apna password likho, jaise:
# DATABASE_URL=postgresql://postgres:mera_password@127.0.0.1:5432/app_db
