{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run JeevanRekha (server side debug)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "📱 Run for mobile (0.0.0.0:3000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-H", "0.0.0.0", "-p", "3000"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "🌐 Debug in Chrome (client side)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full stack debug (server + browser)",
      "configurations": ["▶ Run JeevanRekha (server side debug)", "🌐 Debug in Chrome (client side)"]
    }
  ]
}
